# MySQL / Sequelize settings
DB_DIALECT=mysql
DB_HOST=127.0.0.1
DB_USER=root
DB_PASS=
DB_NAME=booksy

# Use MySQL instead of MongoDB (set to 'true' to force)
USE_MYSQL=true

# MongoDB fallback (if not using MySQL)
MONGODB_URI=mongodb://localhost:27017/booksy

# JWT
JWT_SECRET=change_this_jwt_secret
JWT_EXPIRE=7d

# OTP / Email (Gmail example - use app password)
EMAIL_SERVICE=gmail
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-password
EMAIL_FROM=Booksy <your-email@gmail.com>
OTP_EXPIRE_MINUTES=10

# Server
PORT=5000

# Local testing using SQLite (no MySQL required)
# Set USE_SQLITE=true to use a local SQLite file instead of MySQL or MongoDB.
USE_SQLITE=true
SQLITE_FILE=./database.sqlite
PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://localhost:27017/booksy
JWT_SECRET=your_jwt_secret_key_here_change_in_production
JWT_EXPIRE=7d
OTP_EXPIRE=10m
CORS_ORIGIN=http://localhost:3000
